# Copie para .env e preencha antes de subir o ambiente:
#   cp .env.example .env

# UID do usuário nos containers (Linux: use $(id -u))
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Usuário admin da UI do Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Postgres de metadata (ambiente local)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
